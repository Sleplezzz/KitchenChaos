{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "vitest",
    "node",
    "import",
    "promise"
  ],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "**/routeTree.gen.ts",
    "dist/**",
    ".output/**",
    ".nitro/**",
    ".vercel/**",
    "assets/**",
    "agent/tmp/**",
    "node_modules/**"
  ],
  "overrides": [
    {
      "files": ["src/**/*.{ts,tsx}", "vite.config.ts", "vitest.config.ts"],
      "env": {
        "browser": true
      }
    },
    {
      "files": ["server/**/*.ts"],
      "env": {
        "node": true
      }
    }
  ]
}
